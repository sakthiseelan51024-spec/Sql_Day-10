delimiter $$
create function grade(mark int)
returns varchar(20)

deterministic
begin
if mark >=50 and mark<60 then
return "average";
elseif mark >=60 and mark<70 then 
return "good";
elseif mark >=70 and mark<80 then
return "excellent";
elseif mark >=80 then
return "outstanding";
else
return "fail";
end if;
end$$
delimiter ;
select grade(70);
SELECT std_name, subject, mark, grade(mark) AS result
FROM student;
